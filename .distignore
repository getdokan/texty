# What ships to WP.org = everything in the repo MINUS the patterns below.

# Build output is intentionally NOT listed (must ship): dist/ vendor/ dependencies/

# Keep this complete: it is the only filter the deploy action applies.

# VCS / CI

.git
.gitignore
.gitattributes
.github

# Editor / OS

.editorconfig
.idea
.vscode
.DS_Store

# Lint / build tooling configs

.php_cs
.prettierrc
.babelrc
phpcs.xml
phpcs.xml.dist
phpcs-report.txt
postcss.config.js
webpack.config.js
tsconfig.json
playwright.config.ts
Gruntfile.js

# Package manifests + sources (built artifacts vendor/dist/dependencies are kept)

composer.json
composer.lock
package.json
package-lock.json
node_modules
src
build
docs
webpack-dependency-mapping.js

# Tests / scripts

tests
bin

# Docs / agent / local env

README.md
CLAUDE.md
.claude
.env
.env.example
.wp-env.json
appsero.json

# Self

.distignore
.svnignore
